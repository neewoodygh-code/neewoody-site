# Cloudflare Pages response headers (added 2026-11-13).
# Before this, browsers re-downloaded every photo after 4 hours.

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Photos: a week, then quietly refreshed in the background.
# Not "forever" because photos are sometimes replaced under the same file name.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Scripts and styles: pages load these with ?v=... so a version bump always fetches fresh.
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800

# Astro build output: file names change whenever content changes, so keep for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

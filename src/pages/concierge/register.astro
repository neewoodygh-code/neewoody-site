---
// Carpentry Concierge sign-up (public, in the sitemap). Field ids, the three-step form and the script are the old register.html, unchanged; payment starts on Paystack from the script.
import Base from '../../layouts/Base.astro';
import '../../styles/forms.css';
import '../../styles/doors.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base title="Become a Member · Carpentry Concierge | Neewoody"
  description="Join Carpentry Concierge — Ghana's members' community for carpenters. Register in two minutes: be found for work, hire trusted trades near you, and get first access to every tool."
  path="/concierge/register" concierge>
  <Nav />
  <main id="main" class="cc-auth" data-nav="dark">
    <div class="card wide">
      <div class="brand">
        <img src="/images/concierge/cc-mark.svg" alt="" width="56" height="56" />
        <h1>Join Carpentry Concierge</h1>
        <p>Register in two minutes. Be found for work, hire trusted carpenters near you, and get first access to every tool we build.</p>
      </div>

  <form class="cc-form" id="regForm" autocomplete="off" onsubmit="return false">
    <div class="steps-ind"><span class="seg on"></span><span class="seg"></span><span class="seg"></span></div>
    <div class="step-label" id="stepLabel">Step 1 of 3 · You</div>

    {/* Step 1: You */}
    <div class="step active" data-step="1">
      <div class="field">
        <label for="r_name">Your name</label>
        <input id="r_name" maxlength="80" required />
      </div>
      <div class="field">
        <label for="r_phone">Phone number <span class="opt">(this is how you log in and how members reach you)</span></label>
        <input id="r_phone" type="tel" inputmode="numeric" placeholder="0XX XXX XXXX" required />
      </div>
      <div class="row">
        <div class="field">
          <label for="r_pin">Choose a 5-digit PIN</label>
          <input id="r_pin" class="pin" type="password" inputmode="numeric" maxlength="5" placeholder="•••••" required />
        </div>
        <div class="field">
          <label for="r_pin2">Confirm PIN</label>
          <input id="r_pin2" class="pin" type="password" inputmode="numeric" maxlength="5" placeholder="•••••" required />
        </div>
      </div>
      <div class="wiz-nav"><button type="button" class="pill navy next" data-next="2">Continue</button></div>
    </div>

    {/* Step 2: Your work */}
    <div class="step" data-step="2">
      <div class="field">
        <label for="r_tier">Membership</label>
        <select id="r_tier">
          <option value="regular">Regular — GHS 50 / month</option>
          <option value="founder">Founding member — GHS 100 once, lifetime</option>
        </select>
        <div class="hint" id="r_tier_hint">You'll pay to join at the end — securely by Mobile Money or card.</div>
      </div>
      <div class="field">
        <label for="r_member_type">What are you?</label>
        <select id="r_member_type"></select>
      </div>
      <div class="field">
        <label for="r_type">Account type</label>
        <select id="r_type">
          <option value="">Individual — just me</option>
          <option value="1">Business — I hire and take on work</option>
        </select>
      </div>
      <div class="field">
        <label for="r_biz">Business name <span class="opt">(optional)</span></label>
        <input id="r_biz" maxlength="80" placeholder="Optional" />
      </div>
      <div class="field">
        <label for="r_area">Your area</label>
        <select id="r_area" required></select>
      </div>
      <div class="row" id="r_carpFields">
        <div class="field">
          <label for="r_lvl">Skill level <span class="opt">(optional)</span></label>
          <select id="r_lvl"><option value="">— not set —</option></select>
        </div>
        <div class="field">
          <label for="r_yrs">Years of experience <span class="opt">(optional)</span></label>
          <input id="r_yrs" type="number" inputmode="numeric" min="0" max="70" placeholder="e.g. 8" />
        </div>
      </div>
      <div id="r_vendorFields">
        <div class="field">
          <label for="r_scale">Shop size <span class="opt">(optional)</span></label>
          <select id="r_scale"><option value="">— not set —</option></select>
        </div>
        <div class="field">
          <label for="r_stock">About your shop <span class="opt">(optional; add items later in your Storefront)</span></label>
          <textarea id="r_stock" placeholder="A short line about your shop — brands you carry, delivery, opening hours…"></textarea>
        </div>
      </div>
      <div class="field">
        <label for="r_avail">Availability <span class="opt">(optional, shows as a badge)</span></label>
        <select id="r_avail"><option value="">— not shown —</option></select>
      </div>
      <div class="field">
        <label for="r_biz_phone">Business / call number <span class="opt">(optional; shown instead of your login number)</span></label>
        <input id="r_biz_phone" type="tel" inputmode="numeric" placeholder="0XX XXX XXXX" />
      </div>
      <div class="field">
        <label class="check">
          <input type="checkbox" id="r_hide_phone" />
          <span>Hide my personal number — other members reach me on the business number above <span class="opt">(requires a business number)</span></span>
        </label>
      </div>
      <div class="field" id="r_sh_wrap">
        <label class="check">
          <input type="checkbox" id="r_sh_delivery" />
          <span>I also do <strong>deliveries &amp; errands</strong> — ping me for buy-for-me requests in my area <span class="opt">(you can set coverage zones later in your profile)</span></span>
        </label>
      </div>
      <div class="wiz-nav">
        <button type="button" class="btn-quiet" data-back="1">Back</button>
        <button type="button" class="pill navy next" data-next="3">Continue</button>
      </div>
    </div>

    {/* Step 3: Trades (carpenters) / What you sell (vendors) */}
    <div class="step" data-step="3">
      <div class="field" id="r_tradesWrap">
        <label>Your trades <span class="opt">(pick all that apply)</span></label>
        <div class="spec-grid" id="r_specs"></div>
      </div>
      <div class="field" id="r_catsWrap">
        <label>What you sell <span class="opt">(products you supply)</span></label>
        <div class="spec-grid" id="r_cats"></div>
        <label>What you do <span class="opt">(services you offer; up to 5, also Sourcing filters)</span></label>
        <div class="spec-grid" id="r_svcs"></div>
        <label for="r_services_other">Other services <span class="opt">(optional; anything not listed)</span></label>
        <input id="r_services_other" type="text" maxlength="160" placeholder="e.g. CNC cutting, veneering" />
      </div>
      <div class="wiz-nav">
        <button type="button" class="btn-quiet" data-back="2">Back</button>
        <button class="pill navy" id="regBtn" type="submit">Join &amp; pay</button>
      </div>
    </div>

    <div class="msg" id="regMsg"></div>
    <p class="terms">The first 100 founding members pay a one-time GHS 100 for lifetime membership — no monthly fees, ever. After that, membership is GHS 50/month. We review every application before approving; once you're approved, log in with your phone and PIN, and we'll be in touch on WhatsApp.</p>
  </form>

  <div class="done" id="regDone">
    <div class="panel">
      <h2>Application received.</h2>
      <p>Thanks for registering. We review every application personally — once you're approved you'll be able to log in with your phone and PIN, and we'll reach out on WhatsApp.</p>
      <a class="pill navy" href="login.html">Go to login</a>
    </div>
  </div>

  <p class="help">Already a member? <a href="login.html">Log in</a></p>
    </div>
  </main>
  <Footer bare />
  <script is:inline src="/js/concierge.js?v=20261113b"></script>
  <script is:inline>
(function () {
  var C = window.Concierge;
  // Weak connection: the shared script didn't load, so nothing below can run.
  // Say so (and offer a reload) instead of the form silently reloading the page.
  if (!C) {
    var m0 = document.getElementById('regMsg');
    if (m0) { m0.className = 'msg error'; m0.innerHTML = 'The page did not load fully, so you cannot log in yet. Check your internet (try switching between Wi-Fi and mobile data), then <a href="#" onclick="location.reload();return false" style="color:inherit;text-decoration:underline">tap here to reload</a>.'; }
    return;
  }
  if (C.tokenAlive()) { location.replace('directory.html'); return; }

  var form = document.getElementById('regForm');
  var btn = document.getElementById('regBtn');
  var msg = document.getElementById('regMsg');

  // Populate area / level / availability / trades from the shared vocabulary.
  C.fillZoneSelect(document.getElementById('r_area'), '', '— select your area —');
  var lvl = document.getElementById('r_lvl');
  C.SKILL_ORDER.forEach(function (k) { var o = document.createElement('option'); o.value = k; o.textContent = C.skillLabel(k); lvl.appendChild(o); });
  var avail = document.getElementById('r_avail');
  C.AVAILABILITY_ORDER.forEach(function (k) { var o = document.createElement('option'); o.value = k; o.textContent = C.availabilityLabel(k); avail.appendChild(o); });
  // member type — skill level only applies to carpenters
  var rType = document.getElementById('r_member_type');
  C.MEMBER_TYPE_ORDER.forEach(function (k) { var o = document.createElement('option'); o.value = k; o.textContent = C.memberTypeLabel(k); rType.appendChild(o); });
  var rScale = document.getElementById('r_scale');
  C.VENDOR_SCALE_ORDER.forEach(function (k) { var o = document.createElement('option'); o.value = k; o.textContent = C.vendorScaleLabel(k); rScale.appendChild(o); });
  var rCarpFields = document.getElementById('r_carpFields');
  var rVendorFields = document.getElementById('r_vendorFields');
  var rTradesWrap = document.getElementById('r_tradesWrap');
  var rCatsWrap = document.getElementById('r_catsWrap');
  function syncRType() {
    var t = rType.value;
    var isCarp = t === 'carpenter', isVendor = t === 'vendor', isCourier = t === 'courier';
    rCarpFields.style.display = isCarp ? '' : 'none';
    rVendorFields.style.display = isVendor ? '' : 'none';
    rTradesWrap.style.display = isCarp ? '' : 'none';
    rCatsWrap.style.display = isVendor ? '' : 'none';
    var shw = document.getElementById('r_sh_wrap'); if (shw) shw.style.display = isCourier ? 'none' : '';
  }
  rType.addEventListener('change', syncRType); syncRType();
  var catGrid = document.getElementById('r_cats');
  C.VENDOR_CATEGORY_ORDER.forEach(function (k) {
    var l = document.createElement('label'); l.className = 'cb';
    l.innerHTML = '<input type="checkbox" value="' + k + '"> <span>' + C.escapeHtml(C.vendorCategoryLabel(k)) + '</span>';
    catGrid.appendChild(l);
  });
  var svcGrid = document.getElementById('r_svcs');
  C.VENDOR_SERVICE_ORDER.forEach(function (k) {
    var l = document.createElement('label'); l.className = 'cb';
    l.innerHTML = '<input type="checkbox" value="' + k + '"> <span>' + C.escapeHtml(C.vendorServiceLabel(k)) + '</span>';
    svcGrid.appendChild(l);
  });
  svcGrid.addEventListener('change', function (e) {
    if (svcGrid.querySelectorAll('input:checked').length > C.VENDOR_SERVICES_MAX && e.target.checked) {
      e.target.checked = false; showErr('You can pick up to ' + C.VENDOR_SERVICES_MAX + ' services.');
    }
  });
  var specGrid = document.getElementById('r_specs');
  C.SPECIALTY_ORDER.forEach(function (k) {
    var l = document.createElement('label'); l.className = 'cb';
    var ex = C.SPECIALTY_EXAMPLES[k];
    l.innerHTML = '<input type="checkbox" value="' + k + '"> <span>' + C.escapeHtml(C.specialtyLabel(k)) +
      (ex ? '<small>' + C.escapeHtml(ex) + '</small>' : '') + '</span>';
    specGrid.appendChild(l);
  });

  function digitsOnly(el, n) { el.addEventListener('input', function () { el.value = el.value.replace(/\D/g, '').slice(0, n); }); }
  digitsOnly(document.getElementById('r_pin'), 5);
  digitsOnly(document.getElementById('r_pin2'), 5);

  // ── multi-step wizard: You → Your work → Your trades ──
  var steps = [].slice.call(form.querySelectorAll('.step'));
  var segs = [].slice.call(form.querySelectorAll('.steps-ind .seg'));
  var stepLabel = document.getElementById('stepLabel');
  var STEP_NAMES = { 1: 'You', 2: 'Your work', 3: 'Your trades' };
  var current = 1;
  function goStep(n) {
    current = n;
    steps.forEach(function (s) { s.classList.toggle('active', +s.getAttribute('data-step') === n); });
    segs.forEach(function (s, i) { s.classList.toggle('on', i < n); });
    stepLabel.textContent = 'Step ' + n + ' of 3 · ' + STEP_NAMES[n];
    msg.className = 'msg'; msg.textContent = '';
    var top = document.querySelector('.brand'); if (top) top.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function validateStep(n) {
    if (n === 1) {
      if (!document.getElementById('r_name').value.trim()) { showErr('Please enter your name.'); return false; }
      if (!C.normalizePhone(document.getElementById('r_phone').value)) { showErr('Enter a valid Ghana phone number.'); return false; }
      var p1 = document.getElementById('r_pin').value, p2 = document.getElementById('r_pin2').value;
      if (!/^\d{5}$/.test(p1)) { showErr('Your PIN must be exactly 5 digits.'); return false; }
      if (p1 !== p2) { showErr('The two PINs don\'t match — please re-enter them.'); return false; }
    }
    if (n === 2) {
      if (!document.getElementById('r_area').value) { showErr('Choose your area.'); return false; }
    }
    return true;
  }
  form.querySelectorAll('[data-next]').forEach(function (b) {
    b.addEventListener('click', function () { var n = +b.getAttribute('data-next'); if (validateStep(n - 1)) goStep(n); });
  });
  form.querySelectorAll('[data-back]').forEach(function (b) {
    b.addEventListener('click', function () { goStep(+b.getAttribute('data-back')); });
  });
  // Enter advances to the next step instead of submitting the form early
  form.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && current < 3 && e.target.tagName === 'INPUT') {
      e.preventDefault();
      var nb = steps[current - 1].querySelector('[data-next]');
      if (nb) nb.click();
    }
  });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    msg.className = 'msg'; msg.textContent = '';
    var name = document.getElementById('r_name').value.trim();
    var phone = C.normalizePhone(document.getElementById('r_phone').value);
    var pin = document.getElementById('r_pin').value;
    var pin2 = document.getElementById('r_pin2').value;
    var isVendorReg = rType.value === 'vendor';
    var specs = [].slice.call(specGrid.querySelectorAll('input:checked')).map(function (c) { return c.value; });
    var cats = [].slice.call(catGrid.querySelectorAll('input:checked')).map(function (c) { return c.value; });
    var svcs = [].slice.call(svcGrid.querySelectorAll('input:checked')).map(function (c) { return c.value; });
    var area = document.getElementById('r_area').value;
    var bizPhoneVal = document.getElementById('r_biz_phone').value.trim();
    var hidePhone = document.getElementById('r_hide_phone').checked;
    var isCourierReg = rType.value === 'courier';
    var sideHustles = (!isCourierReg && document.getElementById('r_sh_delivery').checked) ? ['deliveries_errands'] : [];

    if (!name) { return showErr('Please enter your name.'); }
    if (!phone) { return showErr('Enter a valid Ghana phone number.'); }
    if (!/^\d{5}$/.test(pin)) { return showErr('Your PIN must be exactly 5 digits.'); }
    if (pin !== pin2) { return showErr('The two PINs don\'t match — please re-enter them.'); }
    if (!area) { return showErr('Choose your area.'); }
    if (hidePhone && !bizPhoneVal) { return showErr('Add a business / call number before hiding your personal number.'); }
    if (rType.value === 'carpenter' && !specs.length) { return showErr('Choose at least one trade.'); }

    btn.disabled = true; btn.textContent = 'Submitting…';
    try {
      var r = await C.api('/public/register', { auth: false, method: 'POST', body: {
        name: name,
        phone: phone,
        pin: pin,
        requested_tier: document.getElementById('r_tier').value,
        business_name: document.getElementById('r_biz').value.trim(),
        is_business: document.getElementById('r_type').value === '1',
        member_type: rType.value,
        stock: isVendorReg ? document.getElementById('r_stock').value.trim() : '',
        vendor_scale: isVendorReg ? rScale.value : '',
        vendor_categories: isVendorReg ? cats : [],
        vendor_services: isVendorReg ? svcs : [],
        services_other: isVendorReg ? document.getElementById('r_services_other').value.trim() : '',
        side_hustles: sideHustles,
        business_phone: bizPhoneVal,
        hide_phone: hidePhone,
        area: area,
        skill_level: rType.value === 'carpenter' ? lvl.value : '',
        years_experience: rType.value === 'carpenter' && document.getElementById('r_yrs').value.trim() !== '' ? Number(document.getElementById('r_yrs').value) : null,
        availability: avail.value,
        specialties: rType.value === 'carpenter' ? specs : []
      }});
      // Pay-to-join: go straight to Paystack's hosted page. (Fallback: if payments
      // aren't configured the API returns {ok:true} and we show the done screen.)
      if (r && r.authorization_url) { btn.textContent = 'Redirecting to payment…'; window.location.href = r.authorization_url; return; }
      form.style.display = 'none';
      document.getElementById('regDone').classList.add('show');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      var code = err && err.data && err.data.error;
      showErr(code === 'member_exists' ? 'That number is already registered. Log in instead.' : (err.message || 'Could not submit. Please try again.'));
      btn.disabled = false; btn.textContent = 'Join & pay';
    }
  });

  // Founder spots: update the hint + drop the founder option once 100 are taken.
  (async function () {
    try {
      var s = await C.api('/public/founder-spots', { auth: false });
      var tier = document.getElementById('r_tier'), hint = document.getElementById('r_tier_hint');
      if (s && s.remaining > 0) {
        hint.textContent = 'Founding: GHS ' + s.fee + ' once (lifetime) · ' + s.remaining + ' of ' + s.cap + ' spots left. Regular: GHS ' + s.monthly + '/month. You pay to join at the end.';
      } else {
        var opt = tier.querySelector('option[value="founder"]'); if (opt) opt.remove();
        hint.textContent = 'Membership is GHS ' + (s ? s.monthly : 50) + '/month. You pay to join at the end — Mobile Money or card.';
      }
    } catch (e) {}
  })();

  function showErr(t) { msg.className = 'msg error'; msg.textContent = t; }
})();
</script>
</Base>

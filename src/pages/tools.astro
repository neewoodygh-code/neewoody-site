---
// Tools index: free calculators + the door into Carpentry Concierge. Session bar ids and script are the old tools.html, unchanged.
import Base from '../layouts/Base.astro';
import '../styles/forms.css';
import '../styles/doors.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Free Carpentry Tools — wardrobe estimator, cut list, job pricing | Neewoody"
  description="Free calculators for homeowners and carpenters, plus Carpentry Concierge — Ghana's members' community for carpenters. Directory, saved cutlists, and workshop tools."
  ogTitle="Carpentry Concierge — Neewoody Custom Woodwork"
  ogDescription="Free tools for homeowners and carpenters. Members get the directory, saved cutlists, and first access to every new tool."
  path="/tools">
  <Nav />
  <main id="main">
    <header class="page-head" data-nav="dark">
      <h1 class="display">Built for builders. And their clients.</h1>
      <div>
        <p>Free calculators for homeowners pricing a project and carpenters running a business. No sign-up needed: open one and go.</p>
        <p style="margin-top:1rem">Only need to hire a carpenter for a job? <a class="ulink light" href="/hire">Post a job</a> and carpenters near you get in touch.</p>
      </div>
    </header>

    <div class="sess" id="cg-guest" style="display:none" data-nav="light">
      <span>Already a Concierge member?</span>
      <a class="ulink" href="/concierge/login">Member login</a>
    </div>
    <div class="sess in" id="cg-member" style="display:none" data-nav="dark">
      <span>Concierge member</span>
      <a class="ulink" href="/concierge/directory">Go to your member area</a>
      <button type="button" onclick="cgLogout()">Log out</button>
    </div>

    <section class="tl" data-nav="light">
      <div class="tl-split">
        <div>
          <p class="for">For homeowners</p>
          <h2>Wardrobe price estimator</h2>
          <p class="say">Get a realistic price range for a custom wardrobe in under two minutes. Enter your dimensions, pick your door style and finish, and see what it should cost, based on actual Accra carpentry rates.</p>
          <a class="pill ink" href="/wardrobe-estimator">Try the estimator</a>
          <p class="say" style="margin-top:1.6rem"><strong>Wardrobe planner.</strong> Choose the size, the doors and what goes behind each one, and see your wardrobe in 3D. Turn it round, look inside, then send the design to us on WhatsApp.</p>
          <a class="ulink" href="/wardrobe-planner">Plan your wardrobe in 3D</a>
        </div>
        <div class="tl-gives">
          <p>What it gives you</p>
          <ul>
            <li>A low to high price range based on your dimensions and spec</li>
            <li>An instant answer, with no form, callback or waiting</li>
            <li>Figures based on current Accra material and labour costs</li>
            <li>A budget to work with before you speak to any carpenter</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="tl alt" data-nav="light">
      <p class="for">For carpenters</p>
      <h2>Workshop tools for serious builders.</h2>
      <div class="tl-rows">
        <div class="tl-row">
          <div><h3>Wardrobe cutlist calculator</h3><p class="cost">Free, no account needed</p></div>
          <p class="say">Enter your wardrobe dimensions and internal configuration and get a full parts list, an optimised cut sheet and a material summary, ready to take to the machine shop or hand to your team.</p>
          <a class="ulink" href="/cutlist">Open the cutlist calculator</a>
        </div>
        <div class="tl-row">
          <div><h3>Cut sheet generator</h3><p class="cost">Free, no account needed</p></div>
          <p class="say">Enter any parts (length, width, quantity) and get a printable cut sheet of boxes with dimensions and edge-band marks, plus how many boards you need. Set your board colour code, print it, and hand it to the machine shop.</p>
          <a class="ulink" href="/cut-sheet">Open the cut sheet generator</a>
        </div>
        <div class="tl-row">
          <div><h3>Smart Generator</h3><p class="cost">Experimental, under construction</p></div>
          <p class="say">Describe a wardrobe and see it in 3D with its cut list, read straight off the model so parts never clash. It is still being built: try it, check every size before you cut, and tell us what is wrong.</p>
          <a class="ulink" href="/smart-generator">Try the Smart Generator</a>
        </div>
        <div class="tl-row">
          <div><h3>Job pricing tool</h3><p class="cost">Members only</p></div>
          <p class="say">A full cost-to-quote engine built for Ghanaian carpenters. Set your overhead rate, crew day rates and markup tiers. Build quotes for cabinetry and hardwood jobs. Track actual costs against quoted. Your data stays private to your account.</p>
          <a class="ulink" href="/carpenter-pricing">Open the pricing tool</a>
        </div>
      </div>
    </section>

    <section class="tl" data-nav="light">
      <p class="for">For carpenters and vendors</p>
      <h2>These tools are just the start.</h2>
      <p class="say"><strong>Carpentry Concierge</strong> is Neewoody’s members’ network for Ghana’s carpenters and vendors: a vetted directory where members hire members, a jobs board, saved cut lists, and first access to every tool we build. Founding membership is open now.</p>
      <div class="tl-acts">
        <a class="pill navy" href="/concierge/">Explore Carpentry Concierge</a>
        <a class="ulink" href="/concierge/login">Already a member? Log in</a>
      </div>
    </section>
  </main>
  <Footer quoteLink />
  <script is:inline src="/js/concierge.js?v=20261113b"></script>
  <script is:inline>
// Guest/member session bar (rule: every Concierge-facing page is a login entry
// point AND a closable session). Marketing pages elsewhere stay static.
function cgLogout(){
  if(window.Concierge) Concierge.clearToken();
  location.reload();
}
(function(){
  var live = window.Concierge && Concierge.tokenAlive();
  var bar = document.getElementById(live ? 'cg-member' : 'cg-guest');
  if(bar) bar.style.display = 'flex';
})();
</script>
</Base>

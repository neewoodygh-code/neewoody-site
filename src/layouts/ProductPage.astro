---
// Product page template (Wardrobes, Kitchens, Beds, …). Each page passes one
// content object from src/content/<slug>.js: hero + an ordered `sections` list.
// Section kinds: intro · feature · types · details · gallery · projects ·
// statement · review · faq · videos · related. Case studies use the same template.
import Base from './Base.astro';
import '../styles/page.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/page/PageHero.astro';
import Feature from '../components/page/Feature.astro';
import Gallery from '../components/page/Gallery.astro';
import Projects from '../components/page/Projects.astro';
import Sections from '../components/page/Sections.astro';
import Viewer from '../components/page/Viewer.astro';
import Videos from '../components/page/Videos.astro';
import { checkContent } from '../content/check.js';
const c = checkContent(Astro.props.c);
let featureN = 0;
---
<Base title={c.seo.title} description={c.seo.description} ogTitle={c.seo.ogTitle} ogDescription={c.seo.ogDescription} path={c.path} pageEvent={c.pageEvent} ogImg={c.hero.img}>
  <Nav />
  <main id="main">
    <PageHero hero={c.hero} waText={c.waText} />
    {c.sections.map((s: any) => {
      if (s.kind === 'feature') return <Feature f={s} flip={featureN++ % 2 === 1} />;
      if (s.kind === 'gallery') return <Gallery g={s} slug={c.slug} />;
      if (s.kind === 'projects') return <Projects p={s} />;
      if (s.kind === 'videos') return <Videos v={s} />;
      return <Sections kind={s.kind} d={s} />;
    })}
    {c.cms !== false && !c.sections.some((s: any) => s.kind === 'gallery') && (
      <Fragment>
        <section id="cms-posts" data-page={c.slug} hidden class="cms-fallback"></section>
        <script is:inline src="/js/cms-posts.js?v=20261113"></script>
      </Fragment>
    )}
  </main>
  <Footer title={c.footer?.title} text={c.footer?.text} quoteLink={c.footer?.quoteLink} waText={c.waText} />
  <Viewer />
</Base>

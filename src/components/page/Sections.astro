---
// Text sections shared by product pages: intro, types (optionally with photos),
// details (compact grid), statement, review, FAQ (+ FAQPage structured data),
// related (a short row of links to other pages).
import { Picture } from 'astro:assets';
import { img } from '../../photos.js';
const { kind, d } = Astro.props;
const items = (kind === 'types' || kind === 'details')
  ? await Promise.all(d.items.map(async ([name, text, photo, alt]: string[]) => ({ name, text, alt, src: photo ? await img(photo) : null })))
  : [];
---
{kind === 'intro' && (
  <section class="intro-sec" id={d.id} data-nav="light">
    <div class="intro-grid">
      <h2 class="intro-title rv">{d.title}</h2>
      <div class="intro-body rv">
        {d.paras.map((p: string) => <p>{p}</p>)}
        {d.link && <a class="ulink" href={d.link[0]}>{d.link[1]}</a>}
      </div>
    </div>
  </section>
)}

{(kind === 'types' || kind === 'details') && (
  <section class={kind === 'details' ? 'types-sec details' : 'types-sec'} id={d.id} data-nav="light">
    {d.title && <div class="types-head rv">
      <h2 class="display">{d.title}</h2>
      {d.text && <p>{d.text}</p>}
    </div>}
    <ul class={'types-list' + (items.some((i: any) => i.src) ? ' with-photos' : '')}>
      {items.map((i: any) => (
        <li class="rv">
          {i.src && <Picture class="types-img" src={i.src} formats={['avif', 'webp']} widths={[600, 1000]} sizes="(min-width: 900px) 45vw, 92vw" alt={i.alt || ''} loading="lazy" />}
          <h3>{i.name}</h3><p>{i.text}</p>
        </li>
      ))}
    </ul>
  </section>
)}

{kind === 'statement' && (
  <section class="statement-sec" data-nav="light">
    <p class="statement rv">{d.text}</p>
  </section>
)}

{kind === 'review' && (
  <section class={'voice' + (d.quote.length > 260 ? ' long' : '')} data-nav="light" aria-labelledby="rev-h">
    <h2 id="rev-h" class="sr">What clients say</h2>
    <figure class="voice-in rv">
      <blockquote>“{d.quote}”</blockquote>
      <figcaption>{d.who}{d.role && <Fragment><span class="slash" aria-hidden="true"></span>{d.role}</Fragment>}</figcaption>
    </figure>
  </section>
)}

{kind === 'related' && (
  <section class="related-sec" data-nav="light">
    <h2>{d.title}</h2>
    <p class="related-links">{d.links.map(([href, label]: [string, string]) => <a class="ulink" href={href}>{label}</a>)}</p>
  </section>
)}

{kind === 'faq' && (
  <section class="faq-sec" data-nav="light" aria-labelledby="faq-h">
    <h2 id="faq-h" class="display rv">{d.title}</h2>
    <div class="faq-list">
      {d.items.map(([q, a]: [string, string]) => (
        <details class="faq-item"><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: d.items.map(([q, a]: [string, string]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    })} />
  </section>
)}

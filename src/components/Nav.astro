---
// Site header: logo, "What we make" (every product page), Portfolio, Contact, WhatsApp.
// Desktop: a small dropdown. Phones: a full-screen native <dialog>.
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import logoDark from '../assets/brand/logo-dark.png';
import { WA, PHONE, SERVICES } from '../data.js';
const more = [['Portfolio', '/portfolio'], ['Contact', '/contact']];
---
<header class="nav" data-tone="dark" id="nav">
  <a class="nav-brand" href="/" aria-label="Neewoody Custom Woodwork, home">
    <Image class="nav-logo on-dark" src={logoLight} alt="" width={180} />
    <Image class="nav-logo on-light" src={logoDark} alt="" width={180} />
  </a>
  <nav aria-label="Main" class="nav-links">
    <div class="nav-drop" id="navDrop">
      <button type="button" class="nav-drop-btn" id="navDropBtn" aria-expanded="false" aria-controls="navDropList">What we make</button>
      <ul class="nav-drop-list" id="navDropList" hidden>
        {SERVICES.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
      </ul>
    </div>
    {more.map(([t, h]) => <a href={h}>{t}</a>)}
  </nav>
  <a class="nav-wa" href={WA}>WhatsApp <span class="nav-num">{PHONE}</span></a>
  <button class="nav-menu" type="button" aria-haspopup="dialog" id="menuOpen">Menu</button>
</header>

<dialog class="menu" id="menu" aria-label="Menu">
  <div class="menu-top">
    <Image class="menu-logo" src={logoLight} alt="Neewoody Custom Woodwork" width={150} />
    <button type="button" class="menu-close" id="menuClose">Close</button>
  </div>
  <nav aria-label="Menu">
    <p class="menu-head">What we make</p>
    {SERVICES.map((s) => <a href={s.href}>{s.name}</a>)}
    <p class="menu-head">More</p>
    {more.map(([t, h]) => <a href={h}>{t}</a>)}
  </nav>
  <a class="menu-wa" href={WA}>WhatsApp {PHONE}</a>
</dialog>

<script>
  const nav = document.getElementById('nav')!;
  // Flip the nav to whatever section sits under it
  let raf = 0;
  const check = () => {
    raf = 0;
    const under = document.elementsFromPoint(24, 38).find((el) => !el.closest('.nav'));
    const sec = under?.closest<HTMLElement>('[data-nav]');
    if (sec) nav.dataset.tone = sec.dataset.nav;
    // frosted backing once we're past the hero, so links never sit on top of body text
    nav.classList.toggle('scrolled', scrollY > innerHeight * 0.8);
  };
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(check); }, { passive: true });
  check();

  // "What we make" dropdown: click to open; Esc, a click elsewhere or tabbing away closes it
  const drop = document.getElementById('navDrop')!;
  const dropBtn = document.getElementById('navDropBtn')!;
  const dropList = document.getElementById('navDropList')!;
  const setDrop = (open: boolean) => { dropList.hidden = !open; dropBtn.setAttribute('aria-expanded', String(open)); };
  dropBtn.addEventListener('click', () => setDrop(dropList.hidden));
  document.addEventListener('click', (e) => { if (!drop.contains(e.target as Node)) setDrop(false); });
  drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget as Node)) setDrop(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !dropList.hidden) { setDrop(false); dropBtn.focus(); } });

  // Phone menu: native <dialog> gives focus trapping and Esc for free
  const menu = document.getElementById('menu') as HTMLDialogElement;
  const openBtn = document.getElementById('menuOpen')!;
  openBtn.addEventListener('click', () => menu.showModal());
  document.getElementById('menuClose')!.addEventListener('click', () => menu.close());
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) menu.close(); });
  menu.addEventListener('close', () => openBtn.focus());
</script>
